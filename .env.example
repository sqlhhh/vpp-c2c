# Copy to .env and fill in real values. NEVER commit .env.
# Every variable the pipeline reads is listed here, with no real values.

# ---- Block 0 / Block 1: data source ----
# Possibility A (simulation, the default): point at the local mock server.
# Possibility B (real inverter): swap these three lines, change nothing else.
API_KEY=your_api_key_here
API_BASE_URL=http://localhost:5000
SITE_ID=demo_site_001

# ---- Block 1: rate limiting ----
# SolarEdge allows 300 requests/day, hard. We pause at 280 for margin.
RATE_LIMIT_MAX=280

# ---- Block 2: polling ----
POLL_INTERVAL_MIN=5          # production cadence, minutes
POLL_INTERVAL_SEC=           # dev override in seconds; leave blank in production
DAYLIGHT_START=06:30
DAYLIGHT_END=19:30

# ---- Block 4: MQTT ----
MQTT_MODE=local              # local | aws | thingspeak
MQTT_TOPIC_ROOT=solar/
MQTT_HOST=localhost
MQTT_PORT=1883

# ---- Block 5: AWS IoT Core (MQTT_MODE=aws) ----
# Certificates live in certs/ and are git-ignored. Paths only, never contents.
AWS_IOT_ENDPOINT=
AWS_ROOT_CA=certs/AmazonRootCA1.pem
AWS_CERT=certs/device-certificate.pem.crt
AWS_PRIVATE_KEY=certs/device-private.pem.key

# ---- Block 5: InfluxDB ----
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=vpp
INFLUX_BUCKET=solar_data

# ---- Block 5: ThingSpeak hot standby (MQTT_MODE=thingspeak) ----
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_WRITE_API_KEY=

# ---- Block 6 / adapters: push ----
# The one swap point. mock_cloud | bridge | sma | victron  (see docs/command_contract.md)
INVERTER_VENDOR=mock_cloud
# 1 = log commands, never call an adapter. Set to 0 only for a supervised run.
DRY_RUN=1
ORIGINATOR_PORT=5001
# Bridge adapter: where pi/bridge.py finds the inverter (mock_inverter.py on the laptop until hardware)
MODBUS_HOST=localhost
MODBUS_PORT=1502
